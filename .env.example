# TEMPLATE ONLY. Copy to ignored .env.local for development.
# Full inventory and deployment handling: docs/security.md.
# NEXT_PUBLIC_* values are browser-visible; never put secrets there.
# When pasting into GitHub Variables, use plain URL text without quotes/Markdown.
NEXT_PUBLIC_SITE_URL=https://bun2too.com
NEXT_PUBLIC_CONTACT_EMAIL=info@bun2too.com
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_EMAIL_CONNECTION=email
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
SITE_ENVIRONMENT=dev
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only settings. No real hosts, identifiers, or credentials in Git.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_EMAIL_CONNECTION=email
TURNSTILE_SECRET_KEY=
SUPPORT_SESSION_SECRET=
# Server-side inquiry delivery via SES SMTP credentials.
# Required for inquiry availability; never put these in NEXT_PUBLIC_*.
SUPPORT_SES_SMTP_HOST=
SUPPORT_SES_SMTP_PORT=587
SUPPORT_SES_SMTP_USERNAME=
SUPPORT_SES_SMTP_PASSWORD=
SUPPORT_INQUIRY_FROM_EMAIL=
SUPPORT_INQUIRY_TO_EMAIL=
# Working editorial HTTPS origin only, without /insights or /api.
# Read-only connection check: npm run insights:check
INSIGHTS_API_ORIGIN=
INSIGHTS_EMBED_ORIGINS=

# Contentful published public website content. Server-only; never NEXT_PUBLIC.
# master = production, qa = dev/QA. Optional fallback snapshot when disabled.
CONTENTFUL_ENABLED=false
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=qa
# Local migration/authoring only. Never synchronized to Netlify runtime.
CONTENTFUL_MANAGEMENT_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Optional AI support. Enable only after isolating public knowledge and a
# dedicated, restricted non-admin account. See docs/support.md.
OPENWEBUI_PUBLIC_SUPPORT_ENABLED=false
OPENWEBUI_BASE_URL=
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL_ID=
OPENWEBUI_KNOWLEDGE_ID=

# Deployment runner only. NEVER copied to website runtime.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# CI/local agent evaluations only; never synchronized to Netlify runtime.
# Use a separate, independent OpenAI-compatible judge with strict JSON support.
AI_EVAL_JUDGE_URL=
AI_EVAL_JUDGE_API_KEY=
AI_EVAL_JUDGE_MODEL=
# CI-only: human approval always required; set true to also require scores/notes.
AI_EVAL_HUMAN_SCORECARD_REQUIRED=false
