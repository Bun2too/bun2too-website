# TEMPLATE ONLY. Copy to ignored .env.local for development.
# Full inventory and deployment handling: docs/security.md.
# NEXT_PUBLIC_* values are browser-visible; never put secrets there.
NEXT_PUBLIC_SITE_URL=https://bun2too.com
NEXT_PUBLIC_CONTACT_EMAIL=info@bun2too.com
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_AUTH0_EMAIL_CONNECTION=email
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
SITE_ENVIRONMENT=dev
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Server-only settings. No real hosts, identifiers, or credentials in Git.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_EMAIL_CONNECTION=email
TURNSTILE_SECRET_KEY=
SUPPORT_SESSION_SECRET=
INSIGHTS_API_ORIGIN=
INSIGHTS_EMBED_ORIGINS=

# Deployment runner only. NEVER copied to website runtime.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
