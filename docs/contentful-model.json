    {
      "id": "b2tPage",
      "name": "Bun2Too · Page",
      "description": "Public route, SEO, page shell, and ordered references to reusable blocks. Publish linked entries and images before the page.",
      "displayField": "name",
      "fields": [
        {
          "localized": false,
          "disabled": false,
          "omitted": false,
          "id": "name",
          "name": "Editorial name",
          "type": "Symbol",
          "required": true,
          "validations": []
        },
        {
          "localized": false,
          "disabled": false,
          "omitted": false,
          "id": "path",
          "name": "Public path",
          "type": "Symbol",
          "required": true,
          "validations": [
            {
              "unique": true
            },
            {
              "regexp": {
                "pattern": "^/(?:[a-z0-9-]+(?:/[a-z0-9-]+)*)?$"
              }
            }
          ]
        },
        {
          "localized": false,
          "disabled": false,
          "omitted": false,
          "id": "seoTitle",
          "name": "SEO title",
          "type": "Symbol",
          "required": true,
          "validations": []
        },
        {
          "localized": false,
          "disabled": false,
          "omitted": false,
          "id": "seoDescription",
          "name": "SEO description",
          "type": "Text"
        },
        {
          "localized": false,
          "disabled": false,
          "omitted": false,
          "id": "layout",
          "name": "Page shell",
          "type": "Symbol",
          "required": true,
          "validations": [
            {
              "in": [
                "default",
                "legal",
                "support",
                "insights"
              ]
            }
          ]
        },
        {
          "localized": false,
          "disabled": false,
          "omitted": false,
          "id": "blocks",
          "name": "Page blocks in display order",
          "type": "Array",
          "required": true,
          "items": {
            "type": "Link",
            "linkType": "Entry",
            "validations": [
              {
                "linkContentType": [
                  "b2tBlock"
                ]
              }
            ]
          },
          "validations": [
            {
              "size": {
                "min": 1,
                "max": 60
              }
            }
          ]
        }
      ]
